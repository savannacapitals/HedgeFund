+# ---- Pochi la Biashara + bank transfer (add these in Vercel > Settings > Environment Variables) ----
+
+# Your Pochi la Biashara number (the number customers pay to)
+POCHI_PHONE=0700021380
+# Optional: the name M-Pesa shows on the "Hakikisha" confirmation screen, so customers can check they have the right number
+POCHI_ACCOUNT_NAME=
+# Set to false to hide Pochi at checkout
+POCHI_ENABLED=true
+# Long random string (16+ characters). Generate one with:  openssl rand -hex 24
+POCHI_WEBHOOK_SECRET=
+
+# Bank transfer is shown at checkout ONLY when the first three are filled in
+BANK_NAME=
+BANK_ACCOUNT_NAME=
+BANK_ACCOUNT_NUMBER=
+BANK_BRANCH=
+BANK_SWIFT_CODE=
+# KES or USD: the currency your bank account receives
+BANK_CURRENCY=KES
+
+# Already used by the stablecoin checkout; also used to convert USD prices into shillings
+# USD_TO_KES_RATE=129.00
