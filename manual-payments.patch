diff --git a/src/app/api/payments/manual/route.ts b/src/app/api/payments/manual/route.ts
new file mode 100644
index 0000000..6c70c38
--- /dev/null
+++ b/src/app/api/payments/manual/route.ts
@@ -0,0 +1,147 @@
+import { NextResponse } from "next/server";
+import { createAdminClient } from "@/lib/supabase/admin";
+import {
+    ManualPaymentError,
+    POCHI_MAX_KES,
+    getBankConfig,
+    getPochiConfig,
+    orderReference,
+    quoteManual,
+    type ManualMethod,
+} from "@/lib/payments/manual/config";
+import { loadPayableOrder } from "@/lib/payments/manual/order";
+import { buildManualView } from "@/lib/payments/manual/view";
+
+function fail(err: any) {
+    if (err instanceof ManualPaymentError) return NextResponse.json({ error: err.message }, { status: err.status });
+    console.error("Manual payment error:", err?.message);
+    return NextResponse.json({ error: "Something went wrong. Please try again." }, { status: 500 });
+}
+
+/** Safe quote: returns null instead of throwing, so one unavailable method never hides the other */
+function safeQuote(order: any, target: "KES" | "USD", whole: boolean) {
+    try {
+        return quoteManual(Number(order.total_amount), order.currency, target, whole);
+    } catch {
+        return null;
+    }
+}
+
+// Which methods are on, what each would cost, and whether this order already has an open payment
+export async function GET(request: Request) {
+    try {
+        const { order } = await loadPayableOrder(new URL(request.url).searchParams.get("orderId"));
+
+        const pochi = getPochiConfig();
+        const bank = getBankConfig();
+        const pochiQuote = pochi ? safeQuote(order, "KES", true) : null;
+        const bankQuote = bank ? safeQuote(order, bank.currency, false) : null;
+
+        const { data: open } = await createAdminClient()
+            .from("manual_payments")
+            .select("*")
+            .eq("order_id", order.id)
+            .in("status", ["awaiting", "submitted"])
+            .maybeSingle();
+
+        return NextResponse.json({
+            pochi: {
+                available: !!pochiQuote && pochiQuote.amount <= POCHI_MAX_KES,
+                tooLarge: !!pochiQuote && pochiQuote.amount > POCHI_MAX_KES,
+                approxAmount: pochiQuote ? `${pochiQuote.amount.toFixed(0)} KES` : null,
+            },
+            bank: {
+                available: !!bankQuote,
+                approxAmount: bankQuote ? `${bankQuote.amount.toFixed(2)} ${bankQuote.currency}` : null,
+            },
+            payment: open ? buildManualView(open) : null,
+        });
+    } catch (err) {
+        return fail(err);
+    }
+}
+
+// Gives the order its payment instructions (or returns the ones it already has)
+export async function POST(request: Request) {
+    try {
+        let body: any = {};
+        try {
+            body = await request.json();
+        } catch {
+            // handled below
+        }
+        const method = body.method as ManualMethod;
+        if (method !== "pochi" && method !== "bank") throw new ManualPaymentError("Unknown payment method.");
+
+        const { user, order } = await loadPayableOrder(body.orderId);
+        const admin = createAdminClient();
+
+        const { data: open } = await admin
+            .from("manual_payments")
+            .select("*")
+            .eq("order_id", order.id)
+            .in("status", ["awaiting", "submitted"])
+            .maybeSingle();
+
+        if (open) {
+            if (open.method === method) return NextResponse.json({ payment: buildManualView(open) });
+            if (open.status === "submitted") {
+                const name = open.method === "pochi" ? "Pochi la Biashara" : "bank transfer";
+                throw new ManualPaymentError(
+                    `You already sent a ${name} payment for this order and it is being checked. Please wait for it to be confirmed.`,
+                    409
+                );
+            }
+            // Customer changed their mind before paying: close the unused one
+            await admin
+                .from("manual_payments")
+                .update({ status: "expired", updated_at: new Date().toISOString() })
+                .eq("id", open.id)
+                .eq("status", "awaiting");
+        }
+
+        let amount: number, currency: "KES" | "USD", rate: number | null;
+        if (method === "pochi") {
+            if (!getPochiConfig()) throw new ManualPaymentError("Pochi la Biashara is not available right now.", 503);
+            ({ amount, currency, rate } = quoteManual(Number(order.total_amount), order.currency, "KES", true));
+            if (amount > POCHI_MAX_KES) {
+                throw new ManualPaymentError("This amount is above the M-Pesa limit per transaction. Please use bank transfer.");
+            }
+        } else {
+            const bank = getBankConfig();
+            if (!bank) throw new ManualPaymentError("Bank transfer is not available right now.", 503);
+            ({ amount, currency, rate } = quoteManual(Number(order.total_amount), order.currency, bank.currency, false));
+        }
+
+        const { data: created, error } = await admin
+            .from("manual_payments")
+            .insert({
+                order_id: order.id,
+                user_id: user.id,
+                method,
+                reference: orderReference(order.id),
+                amount,
+                currency,
+                fx_rate: rate,
+            })
+            .select("*")
+            .single();
+
+        if (error) {
+            // A parallel click already created it: hand that one back
+            if (error.code === "23505") {
+                const { data: again } = await admin
+                    .from("manual_payments")
+                    .select("*")
+                    .eq("order_id", order.id)
+                    .in("status", ["awaiting", "submitted"])
+                    .maybeSingle();
+                if (again && again.method === method) return NextResponse.json({ payment: buildManualView(again) });
+            }
+            throw error;
+        }
+        return NextResponse.json({ payment: buildManualView(created) });
+    } catch (err) {
+        return fail(err);
+    }
+}
diff --git a/src/app/api/payments/manual/status/route.ts b/src/app/api/payments/manual/status/route.ts
new file mode 100644
index 0000000..dde02f7
--- /dev/null
+++ b/src/app/api/payments/manual/status/route.ts
@@ -0,0 +1,37 @@
+import { NextResponse } from "next/server";
+import { createClient } from "@/lib/supabase/server";
+import { createAdminClient } from "@/lib/supabase/admin";
+import { redirectForOrder, trySettlePochi } from "@/lib/payments/manual/settle";
+
+// The checkout page asks this every few seconds while it waits for the payment to be confirmed
+export async function GET(request: Request) {
+    const supabase = await createClient();
+    const {
+        data: { user },
+    } = await supabase.auth.getUser();
+    if (!user) return NextResponse.json({ error: "Please sign in." }, { status: 401 });
+
+    const paymentId = new URL(request.url).searchParams.get("paymentId");
+    if (!paymentId) return NextResponse.json({ error: "Missing payment." }, { status: 400 });
+
+    const admin = createAdminClient();
+    const lookup = () =>
+        admin.from("manual_payments").select("id, order_id, method, status").eq("id", paymentId).eq("user_id", user.id).maybeSingle();
+
+    let { data: payment } = await lookup();
+    if (!payment) return NextResponse.json({ error: "Payment not found." }, { status: 404 });
+
+    // Covers the case where the SMS arrived but the webhook could not settle it at the time
+    if (payment.status === "submitted" && payment.method === "pochi") {
+        try {
+            await trySettlePochi(payment.id);
+            ({ data: payment } = await lookup());
+        } catch (err: any) {
+            console.error("Pochi status check failed:", err.message);
+        }
+    }
+
+    const body: Record<string, unknown> = { status: payment!.status };
+    if (payment!.status === "succeeded") body.redirectTo = await redirectForOrder(payment!.order_id);
+    return NextResponse.json(body);
+}
diff --git a/src/app/api/payments/manual/submit/route.ts b/src/app/api/payments/manual/submit/route.ts
new file mode 100644
index 0000000..655d0b9
--- /dev/null
+++ b/src/app/api/payments/manual/submit/route.ts
@@ -0,0 +1,100 @@
+import { NextResponse } from "next/server";
+import { createClient } from "@/lib/supabase/server";
+import { createAdminClient } from "@/lib/supabase/admin";
+import { MPESA_CODE, normaliseMpesaCode } from "@/lib/payments/manual/sms";
+import { redirectForOrder, trySettlePochi } from "@/lib/payments/manual/settle";
+import { buildManualView } from "@/lib/payments/manual/view";
+
+const MAX_ATTEMPTS = 6;
+
+// The customer tells us what they paid with: the M-Pesa code (Pochi) or the bank reference (bank)
+export async function POST(request: Request) {
+    const supabase = await createClient();
+    const {
+        data: { user },
+    } = await supabase.auth.getUser();
+    if (!user) return NextResponse.json({ error: "Please sign in." }, { status: 401 });
+
+    let body: any = {};
+    try {
+        body = await request.json();
+    } catch {
+        // handled below
+    }
+    if (!body.paymentId) return NextResponse.json({ error: "Missing payment." }, { status: 400 });
+
+    const admin = createAdminClient();
+    const { data: payment } = await admin
+        .from("manual_payments")
+        .select("*")
+        .eq("id", body.paymentId)
+        .eq("user_id", user.id)
+        .maybeSingle();
+    if (!payment) return NextResponse.json({ error: "Payment not found." }, { status: 404 });
+    if (payment.status !== "awaiting" && payment.status !== "submitted") {
+        return NextResponse.json({ error: "This payment can no longer be changed." }, { status: 409 });
+    }
+    if (payment.attempts >= MAX_ATTEMPTS) {
+        return NextResponse.json({ error: "Too many attempts. Please contact support with your reference." }, { status: 429 });
+    }
+
+    // The order must still be open
+    const { data: order } = await admin.from("orders").select("status").eq("id", payment.order_id).maybeSingle();
+    if (!order || order.status !== "pending") {
+        return NextResponse.json({ error: "This order is not awaiting payment." }, { status: 409 });
+    }
+
+    let providerRef: string;
+    if (payment.method === "pochi") {
+        providerRef = normaliseMpesaCode(body.providerRef);
+        if (!MPESA_CODE.test(providerRef)) {
+            return NextResponse.json(
+                { error: "That does not look like an M-Pesa code. It has 10 letters and numbers, for example SGL4ABC12D." },
+                { status: 400 }
+            );
+        }
+    } else {
+        providerRef = String(body.providerRef || "").trim();
+        if (providerRef.length < 4 || providerRef.length > 64) {
+            return NextResponse.json({ error: "Enter the transaction reference from your bank (4 to 64 characters)." }, { status: 400 });
+        }
+    }
+    const payerName = String(body.payerName || "").trim().slice(0, 80) || null;
+
+    const { data: updated, error } = await admin
+        .from("manual_payments")
+        .update({
+            provider_ref: providerRef,
+            payer_name: payerName,
+            status: "submitted",
+            attempts: payment.attempts + 1,
+            submitted_at: new Date().toISOString(),
+            updated_at: new Date().toISOString(),
+        })
+        .eq("id", payment.id)
+        .in("status", ["awaiting", "submitted"])
+        .select("*")
+        .maybeSingle();
+
+    if (error) {
+        if (error.code === "23505") {
+            return NextResponse.json({ error: "That code has already been used for another payment." }, { status: 409 });
+        }
+        console.error("Manual payment submit failed:", error.message);
+        return NextResponse.json({ error: "Could not save your payment. Please try again." }, { status: 500 });
+    }
+    if (!updated) return NextResponse.json({ error: "This payment can no longer be changed." }, { status: 409 });
+
+    // Pochi: the SMS may already be here
+    let status = updated.status;
+    let redirectTo: string | undefined;
+    if (updated.method === "pochi") {
+        const result = await trySettlePochi(updated.id);
+        if (result === "settled") {
+            status = "succeeded";
+            redirectTo = await redirectForOrder(updated.order_id);
+        }
+    }
+
+    return NextResponse.json({ payment: { ...buildManualView(updated), status }, redirectTo });
+}
