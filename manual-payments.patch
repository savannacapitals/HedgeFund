+++ b/src/lib/payments/manual/order.ts
@@ -0,0 +1,22 @@
+import { createClient } from "@/lib/supabase/server";
+import { ManualPaymentError } from "@/lib/payments/manual/config";
+
+/** The signed-in user's own pending order. Row-level security only returns orders that belong to them. */
+export async function loadPayableOrder(orderId: string | null | undefined) {
+    const supabase = await createClient();
+    const {
+        data: { user },
+    } = await supabase.auth.getUser();
+    if (!user) throw new ManualPaymentError("Please sign in.", 401);
+    if (!orderId) throw new ManualPaymentError("Missing order.", 400);
+
+    const { data: order } = await supabase
+        .from("orders")
+        .select("id, user_id, total_amount, currency, status")
+        .eq("id", orderId)
+        .maybeSingle();
+
+    if (!order) throw new ManualPaymentError("Order not found.", 404);
+    if (order.status !== "pending") throw new ManualPaymentError("This order is not awaiting payment.", 409);
+    return { user, order };
+}
diff --git a/src/lib/payments/manual/settle.ts b/src/lib/payments/manual/settle.ts
new file mode 100644
index 0000000..532e295
--- /dev/null
+++ b/src/lib/payments/manual/settle.ts
@@ -0,0 +1,70 @@
+import { createAdminClient } from "@/lib/supabase/admin";
+import { completeOrder } from "@/lib/payments/fulfil";
+
+export type SettleResult = "settled" | "no_message" | "underpaid" | "not_eligible" | "failed";
+
+/**
+ * Confirms a submitted Pochi payment if the forwarded M-Pesa SMS for its code has arrived and the amount covers the price.
+ * Safe to call any number of times, from the customer's page, the webhook or both at once:
+ * the SMS is "claimed" with a conditional update, so it can pay for exactly one order.
+ */
+export async function trySettlePochi(paymentId: string): Promise<SettleResult> {
+    const admin = createAdminClient();
+
+    const { data: payment } = await admin
+        .from("manual_payments")
+        .select("id, order_id, method, status, amount, currency, provider_ref")
+        .eq("id", paymentId)
+        .maybeSingle();
+    if (!payment || payment.method !== "pochi" || payment.status !== "submitted" || !payment.provider_ref) {
+        return "not_eligible";
+    }
+
+    const { data: message } = await admin
+        .from("pochi_messages")
+        .select("id, amount, claimed_by")
+        .eq("mpesa_code", String(payment.provider_ref).toUpperCase())
+        .maybeSingle();
+    if (!message || message.claimed_by) return "no_message";
+
+    // The customer pays in KES; an SMS for less than the price never confirms anything by itself
+    if (!(Number(message.amount) >= Number(payment.amount))) return "underpaid";
+
+    // Claim the SMS. If another request got there first, this returns no row.
+    const { data: claimed } = await admin
+        .from("pochi_messages")
+        .update({ claimed_by: payment.id })
+        .eq("id", message.id)
+        .is("claimed_by", null)
+        .select("id")
+        .maybeSingle();
+    if (!claimed) return "no_message";
+
+    const result = await completeOrder(payment.order_id);
+    if (!result.ok) {
+        // Order cannot be paid (e.g. it was closed): give the SMS back so an admin can sort it out
+        await admin.from("pochi_messages").update({ claimed_by: null }).eq("id", message.id);
+        console.error("Pochi settle: could not complete order", payment.order_id, result.message);
+        return "failed";
+    }
+
+    const now = new Date().toISOString();
+    await admin
+        .from("manual_payments")
+        .update({ status: "succeeded", paid_at: now, updated_at: now })
+        .eq("id", payment.id)
+        .eq("status", "submitted");
+    return "settled";
+}
+
+/** Where to send the customer once an order is paid */
+export async function redirectForOrder(orderId: string): Promise<string> {
+    const admin = createAdminClient();
+    const { data: order } = await admin.from("orders").select("course_id, kind").eq("id", orderId).maybeSingle();
+    if (order?.kind === "community") return "/community/killzone";
+    if (order?.course_id) {
+        const { data: course } = await admin.from("courses").select("slug").eq("id", order.course_id).maybeSingle();
+        if (course?.slug) return `/learn/${course.slug}/lessons`;
+    }
+    return "/dashboard";
+}
diff --git a/src/lib/payments/manual/sms.ts b/src/lib/payments/manual/sms.ts
new file mode 100644
index 0000000..d8b0529
--- /dev/null
+++ b/src/lib/payments/manual/sms.ts
@@ -0,0 +1,38 @@
+/**
+ * Reads the M-Pesa SMS that arrives on the Pochi phone when a customer pays, e.g.
+ *   "SGL4ABC12D Confirmed. You have received Ksh500.00 from JOHN DOE ..."
+ * Only the code, the amount and (if present) the sender's name are used.
+ * The wording of M-Pesa SMS changes now and then, so every part is matched loosely and anything that
+ * does not look like an incoming payment is ignored. TEST WITH A REAL SMS before going live.
+ */
+export interface ParsedPochiSms {
+    code: string;
+    amount: number;
+    sender: string | null;
+}
+
+export const MPESA_CODE = /^[A-Z][A-Z0-9]{9}$/;
+
+export function normaliseMpesaCode(input: string): string {
+    return String(input || "").trim().toUpperCase().replace(/\s+/g, "");
+}
+
+export function parsePochiSms(message: string): ParsedPochiSms | null {
+    const text = String(message || "").replace(/\s+/g, " ").trim();
+    if (!text) return null;
+
+    // Only incoming money: skip "you have sent", "paid to", "withdraw", balances, airtime and so on
+    if (!/\breceived\b/i.test(text)) return null;
+
+    const code = text.match(/\b([A-Z][A-Z0-9]{9})\b\s*(?:Confirmed|confirmed)/i)?.[1]?.toUpperCase();
+    if (!code || !MPESA_CODE.test(code)) return null;
+
+    const amountText = text.match(/received\s+(?:Ksh|KES)\.?\s*([\d,]+(?:\.\d{1,2})?)/i)?.[1];
+    if (!amountText) return null;
+    const amount = Number(amountText.replace(/,/g, ""));
+    if (!Number.isFinite(amount) || amount <= 0) return null;
+
+    const sender = text.match(/\bfrom\s+(.+?)(?:\s+\d{9,12}\b|\s+on\s+\d|\.\s|$)/i)?.[1]?.trim().slice(0, 80) || null;
+
+    return { code, amount, sender };
+}
diff --git a/src/lib/payments/manual/view.ts b/src/lib/payments/manual/view.ts
new file mode 100644
index 0000000..d9bc034
--- /dev/null
+++ b/src/lib/payments/manual/view.ts
@@ -0,0 +1,30 @@
+import { getBankConfig, getPochiConfig, type ManualMethod } from "@/lib/payments/manual/config";
+
+/** What the browser is allowed to see about a manual payment */
+export function buildManualView(p: any) {
+    const method = p.method as ManualMethod;
+    const view: Record<string, unknown> = {
+        id: p.id,
+        method,
+        status: p.status,
+        amount: Number(p.amount).toFixed(2),
+        currency: p.currency,
+        reference: p.reference,
+        providerRef: p.provider_ref ?? null,
+    };
+    if (method === "pochi") {
+        const c = getPochiConfig();
+        view.pochi = c && { phone: c.phone, displayPhone: c.displayPhone, accountName: c.accountName };
+    } else {
+        const c = getBankConfig();
+        view.bank = c && {
+            bankName: c.bankName,
+            accountName: c.accountName,
+            accountNumber: c.accountNumber,
+            branch: c.branch,
+            swift: c.swift,
+            currency: c.currency,
+        };
+    }
+    return view;
+}
diff --git a/supabase/migrations/00013_manual_payments.sql b/supabase/migrations/00013_manual_payments.sql
new file mode 100644
index 0000000..ee0496d
--- /dev/null
+++ b/supabase/migrations/00013_manual_payments.sql
@@ -0,0 +1,59 @@
+-- ================================================================
+-- 00013: Pochi la Biashara and bank-transfer payments
+-- Neither has a collection API, so the customer pays outside the site and then gives us the
+-- M-Pesa code (Pochi) or the bank transaction reference (bank). Pochi payments are confirmed
+-- automatically when the matching M-Pesa SMS reaches /api/webhooks/pochi. Bank payments (and
+-- any Pochi payment the SMS never confirms) are confirmed by an admin on /admin/orders.
+-- Browsers have no access to these tables.
+-- ================================================================
+
+create table public.manual_payments (
+  id uuid primary key default gen_random_uuid(),
+  order_id uuid not null references public.orders(id) on delete cascade,
+  user_id uuid not null references public.profiles(id) on delete cascade,
+  method text not null check (method in ('pochi', 'bank')),
+  reference text not null,                          -- short order reference shown to the customer, e.g. SC-1A2B3C4D
+  amount numeric(14, 2) not null check (amount > 0),  -- what the customer must pay, in `currency`
+  currency text not null check (currency in ('KES', 'USD')),
+  fx_rate numeric(12, 4),                           -- shillings per dollar, only when the order had to be converted
+  provider_ref text,                                -- M-Pesa code or bank reference typed in by the customer
+  payer_name text,
+  attempts int not null default 0,
+  status text not null default 'awaiting'
+    check (status in ('awaiting', 'submitted', 'succeeded', 'expired')),
+  submitted_at timestamptz,
+  paid_at timestamptz,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+create index manual_payments_user_idx on public.manual_payments (user_id);
+create index manual_payments_status_idx on public.manual_payments (status, created_at);
+
+-- One open manual payment per order
+create unique index manual_payments_one_open_per_order
+  on public.manual_payments (order_id) where status in ('awaiting', 'submitted');
+
+-- A code or reference can only back one payment
+create unique index manual_payments_ref_unique
+  on public.manual_payments (method, upper(provider_ref))
+  where provider_ref is not null and status in ('submitted', 'succeeded');
+
+-- Every "you have received" M-Pesa SMS the phone forwards to us (your reconciliation record)
+create table public.pochi_messages (
+  id uuid primary key default gen_random_uuid(),
+  mpesa_code text not null unique,
+  amount numeric(14, 2) not null check (amount > 0),
+  sender_name text,
+  raw text not null,
+  claimed_by uuid unique references public.manual_payments(id),
+  received_at timestamptz not null default now()
+);
+create index pochi_messages_unclaimed_idx on public.pochi_messages (received_at) where claimed_by is null;
+
+alter table public.manual_payments enable row level security;
+alter table public.pochi_messages enable row level security;
+
+-- No policies on purpose: only the server (service role) can read or write these.
+revoke all on public.manual_payments from anon, authenticated;
+revoke all on public.pochi_messages from anon, authenticated;
