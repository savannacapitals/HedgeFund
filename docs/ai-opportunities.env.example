# Savanna AI Opportunities. All optional: the defaults below apply when a variable is not set.
# Prices are decided on the server only. The browser never sends a price.

# Membership price in Kenyan shillings (default 100)
AI_MEMBERSHIP_PRICE_KES=100
# Days of access per paid membership period (default 30)
AI_MEMBERSHIP_DAYS=30
# Account assistance price in US dollars, per platform request (default 15)
AI_ASSISTANCE_PRICE_USD=15

# Already required by the existing payments (see docs/manual-payments.md):
#   USD_TO_KES_RATE   needed so the USD 15 assistance fee can be paid by Pochi / bank in shillings,
#                     and so the KES 100 membership can be paid with USDC / USDT
#   POCHI_PHONE, POCHI_WEBHOOK_SECRET, BANK_* ...
